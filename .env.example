# =============================================================================
# Super Benfica Web - loja online
# Copie para .env.local e ajuste. Para PRODUÇÃO, troque apenas estas URLs.
# Nenhum segredo do backend (DJANGO_SECRET_KEY, DB_PASSWORD, REDIS_URL etc.)
# deve ficar aqui: o frontend só conversa com a API pela URL dela.
# =============================================================================

# URL da API Django usada pelo servidor Next (BFF / route handlers). Nunca vai ao navegador.
# Dev: http://127.0.0.1:8000 | Docker: http://host.docker.internal:8000
API_URL=http://127.0.0.1:8000

# URL do WebSocket (Django Channels) acessada pelo navegador.
# Produção: wss://api.seudominio.com.br
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000

# development | staging | production (controla cookies Secure, HSTS e CSP)
NEXT_PUBLIC_APP_ENV=development
